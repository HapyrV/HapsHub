<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Detect Linux OS directly, or via -r linux-x64 flag if cross-compiling -->
    <_LinuxBuild Condition="'$(RuntimeIdentifier)' != '' and !$(RuntimeIdentifier.StartsWith('linux'))">false</_LinuxBuild>
    <_LinuxBuild Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">true</_LinuxBuild>
    <_LinuxBuild Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">true</_LinuxBuild>

    <TargetFramework Condition="'$(_LinuxBuild)'!='true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(_LinuxBuild)'=='true'">net10.0</TargetFramework>

    <OutputType Condition="'$(_LinuxBuild)'!='true'">WinExe</OutputType>
    <OutputType Condition="'$(_LinuxBuild)'=='true'">Exe</OutputType>

    <RootNamespace>VRCNext</RootNamespace>
    <AssemblyName>HapsHub</AssemblyName>
    <EnableWindowsTargeting Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</EnableWindowsTargeting>
    <RollForward>latestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon Condition="'$(_LinuxBuild)'!='true'">logo.ico</ApplicationIcon>
    <CETCompat>false</CETCompat>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <UseWindowsForms Condition="'$(_LinuxBuild)'!='true'">true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Define WINDOWS when targeting Windows (RID win-*), or when building on Windows without a specific RID (local dev build) -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) OR ($([MSBuild]::IsOSPlatform('Windows')) AND '$(RuntimeIdentifier)' == '')">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="VRChat.OSCQuery" Version="0.0.7" />
    <ProjectReference Include="external\photino.NET\Photino.NET\Photino.NET.csproj" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.6.0-alpha" />
    <PackageReference Include="Rsync.Delta" Version="1.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" Condition="'$(_LinuxBuild)'=='true'" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" Condition="'$(_LinuxBuild)'=='true'" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="Velopack" Version="0.0.915" />
    <PackageReference Include="Vosk" Version="0.3.38" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="Whisper.net" Version="1.9.1" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="NAudio" Version="3.0.0" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="System.Speech" Version="10.0.14" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" Condition="'$(_LinuxBuild)'!='true'" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="REFS\**" />
    <Content Remove="REFS\**" />
    <EmbeddedResource Remove="REFS\**" />
    <None Remove="REFS\**" />
    <Compile Remove="external\**" />
    <Content Remove="external\**" />
    <EmbeddedResource Remove="external\**" />
    <None Remove="external\**" />
    <Compile Remove="translations\**" />
    <Content Remove="translations\**" />
    <EmbeddedResource Remove="translations\**" />
    <None Remove="translations\**" />
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
    <Compile Remove="kikitan-translator\**" />
    <Content Remove="kikitan-translator\**" />
    <EmbeddedResource Remove="kikitan-translator\**" />
    <None Remove="kikitan-translator\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="frontend\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="voice\**\*" Condition="'$(_LinuxBuild)'!='true'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Services\Assets\SystemTray\*.png" Condition="'$(_LinuxBuild)'!='true'" Link="tray\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Services\Assets\FrameShot\*.wav" Condition="'$(_LinuxBuild)'!='true'" Link="frameshot\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Services\OpenVR\openvr_api.dll" Condition="'$(_LinuxBuild)'!='true'" Link="openvr_api.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Services\OpenVR\input\*.json" Link="vrinput\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Notes the commit this build came from, so a copy in bin\Release can tell when the repository has moved on -->
  <Target Name="StampSourceCommit" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HubSourceCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_HubSourceExit" />
    </Exec>
    <WriteLinesToFile Condition="'$(_HubSourceExit)' == '0'" File="$(OutDir)source-commit.txt" Lines="$(_HubSourceCommit)" Overwrite="true" />
  </Target>

  <!-- Inject webhook key from build environment into a generated file -->
  <Target Name="GenerateWhKeySecret" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\BuildSecrets.cs" Lines="namespace VRCNext%3B internal static class BuildSecrets { internal const string HypeRateApiKey = %22$(VRCNextHypeRateApiKey)%22%3B internal const string VrcndbKey = %22$(VRCNextVrcndbKey)%22%3B }" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)\BuildSecrets.cs" />
    </ItemGroup>
  </Target>

</Project>
